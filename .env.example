# ============================================================
# FEVER MJ サーバー 環境変数のサンプル
# このファイルをコピーして .env という名前で保存し、値を編集してください。
# .env ファイル自体は Git に乗せません（.gitignore で除外しています）。
# ============================================================

# サーバーの待ち受けポート番号
# 本番環境（Render など）では自動で設定されるので、ローカル開発用の値
PORT=3000

# 動作モード（development = 開発中 / production = 本番公開時）
NODE_ENV=development

# SQLite データベースファイルの保存場所
# フェーズ5（戦績記録）で使います
DB_PATH=./data/fever-mj.db
